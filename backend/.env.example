# SERVER
PORT=5000
NODE_ENV=development

# REQUEST AUTO-DENY (built-in scheduler runs after database connection)
AUTO_DENY_DAYS=7
AUTO_DENY_INTERVAL_MINUTES=1

# OPTIONAL EXTERNAL CRON (x-cron-secret header)
CRON_SECRET=

# CLIENT
CLIENT_URL=http://localhost:5173

# DATABASE
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_VERIFY_SECRET=

ACCESS_TOKEN_EXPIRES=15m
# Refresh tokens: 30 days with "Remember me", otherwise 1 day in a session
# cookie (fixed in src/utils/generateToken.js).

# PASSWORD RESET (HMAC key for OTP/reset-token hashes; falls back to a key
# derived from JWT_REFRESH_SECRET when empty)
PASSWORD_RESET_SECRET=

# BREVO
BREVO_API_KEY=
EMAIL_FROM=

# Aiven Valkey (ioredis TCP connection, used for direct get/set/del AND BullMQ)
VALKEY_HOST=
VALKEY_PORT=
VALKEY_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=
